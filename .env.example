# Postgres
SIFT_PG_DSN=postgresql+asyncpg://sift:sift@localhost:5432/sift
SIFT_PG_POOL_MIN=5
SIFT_PG_POOL_MAX=50

# Valkey
SIFT_VALKEY_URL=redis://localhost:6379/0

# Storage
SIFT_STORAGE_ENDPOINT=http://localhost:8333
SIFT_STORAGE_BUCKET=sift-uploads
SIFT_STORAGE_ACCESS_KEY=sift
SIFT_STORAGE_SECRET_KEY=sift-secret-change-me

# Auth (Phase 1)
SIFT_ZITADEL_ISSUER=
SIFT_ZITADEL_AUDIENCE=sift-api
SIFT_ZITADEL_INTROSPECT_URL=
SIFT_API_KEY_PEPPER=

# LLM
SIFT_LLM_PROVIDER=openai
SIFT_LLM_MODEL=gpt-4.1-mini
SIFT_LLM_API_KEY=

# Embeddings
SIFT_EMBED_URL=http://localhost:8080
SIFT_EMBED_MODEL=BAAI/bge-m3
SIFT_RERANK_URL=http://localhost:8081

# Vector
SIFT_VECTOR_BACKEND=pgvector
SIFT_QDRANT_URL=http://localhost:6333

# MCP
SIFT_MCP_ENABLED=true
SIFT_MCP_PATH=/mcp
SIFT_MCP_ISSUER=

# Rate limits
SIFT_RATE_LIMIT_RPM=120

# Observability
SIFT_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SIFT_LANGFUSE_URL=
SIFT_LANGFUSE_PUBLIC_KEY=
SIFT_LANGFUSE_SECRET_KEY=
